# OpenRouter Configuration
# Get your API key from https://openrouter.ai/keys

# Required: OpenRouter API Key
OPENROUTER_API_KEY=your-api-key-here

# Optional: OpenRouter model selection
# Default: cognitivecomputations/dolphin-mistral-24b-venice-edition:free
OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition:free

# Optional: Maximum tokens for response
# Default: 5000 (for complete responses)
OPENROUTER_MAX_TOKENS=5000

# Optional: Response temperature (0-2)
# Lower = more consistent, Higher = more creative
# Default: 0.7
OPENROUTER_TEMPERATURE=0.7

# Optional: API timeout in seconds
# Default: 60
OPENROUTER_TIMEOUT=60

# Vault Configuration
# Path to your Obsidian vault
# Default: ./vault (relative to project root)
VAULT_ROOT=./vault

# Optional: Custom OpenRouter API base URL (for self-hosted)
# Uncomment to use custom endpoint
# OPENROUTER_API_BASE=https://custom.openrouter.endpoint

# Instructions for setup:
# 1. Copy this file to .env
# 2. Add your OpenRouter API key from https://openrouter.ai/keys
# 3. Adjust vault location if using a different path
# 4. Run: python -m tree_of_thoughts.vault.vault_sync_simple session --help
