# ============================================================
# Tree of Thoughts — Obsidian Vault Integration
# Copy this file to .env and fill in your values.
# ============================================================

# ── Anthropic ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Model settings (optional, defaults shown) ─────────────
ANTHROPIC_MODEL=claude-opus-4-6
TOT_MAX_TOKENS=1500
TOT_TEMPERATURE=0.7
TOT_LANGUAGE=fr

# ── Docker user (match your Windows/WSL2 UID) ─────────────
# Run `id -u` and `id -g` on WSL2 to find these values
DOCKER_UID=1000
DOCKER_GID=1000

# ── Vault host paths (Windows D:\ → /d/ in WSL2) ─────────
# Adjust the drive letter or path if your vault is elsewhere.
# These are the HOST paths mounted by docker-compose.

VAULT_PSYCHE_HOST=/d/Vault/Vault/_PSYCHE
VAULT_BRAIN_HOST=/d/Vault/Vault/_BRAIN
VAULT_KNOWLEDGE_HOST=/d/Vault/Vault/KNOWLEDGE
VAULT_RAPPORT_HOST=/d/Vault/Vault/RAPPORT QUOTIDIEN, HEBDOMADAIRE,MENSUEL & ANNUEL

# ── Vault section paths INSIDE the container ──────────────
# These are the container-side paths passed to vault_sync.py
# so each section stays isolated and notes never mix.
# Must match the "target:" values in docker-compose.yml.

VAULT_PSYCHE_PATH=/vault/_PSYCHE
VAULT_BRAIN_PATH=/vault/_BRAIN
VAULT_KNOWLEDGE_PATH=/vault/KNOWLEDGE
VAULT_RAPPORT_PATH=/vault/RAPPORT QUOTIDIEN, HEBDOMADAIRE,MENSUEL & ANNUEL

# ── Logs directory on host ────────────────────────────────
# ToT session JSON files are stored here and also read by
# the report generator.
LOGS_HOST=./logs
